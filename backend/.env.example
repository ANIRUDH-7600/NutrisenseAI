# ==============================================================================
# NutriSense AI — Backend Environment Configuration Template
# Copy this file to '.env' in the backend/ folder:
#   cp .env.example .env
# ==============================================================================

# Environment mode: 'development' or 'production'
NUTRISENSE_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Configuration
# ------------------------------------------------------------------------------
# 1. For Local MongoDB:
MONGODB_URI=mongodb://localhost:27017

# 2. For MongoDB Atlas Cloud (uncomment and replace with your credentials):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Target database name
MONGODB_DB_NAME=nutrisense_ai

# Enable or disable database persistence (true/false)
MONGODB_ENABLED=true

# Server selection timeout in milliseconds (fail-soft if MongoDB is offline)
MONGODB_TIMEOUT_MS=2000

# ------------------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated, for production deployments)
# ------------------------------------------------------------------------------
NUTRISENSE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Secure random secret key for signing JWT tokens (min 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long

# Cryptographic signing algorithm (HS256 recommended)
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

