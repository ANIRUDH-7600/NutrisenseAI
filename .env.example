# ==============================================================================
# NutriSense AI — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the backend/ folder for backend configuration:
#   cp .env.example backend/.env
# Copy frontend settings to 'frontend/.env' for frontend configuration:
#   cp frontend/.env.example frontend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------

# Environment mode: 'development' or 'production'
NUTRISENSE_ENV=development

# MongoDB Connection URI (Local or MongoDB Atlas Cloud)
MONGODB_URI=mongodb://localhost:27017
# Example for Atlas Cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Target database name
MONGODB_DB_NAME=nutrisense_ai

# Enable or disable database persistence (true/false)
MONGODB_ENABLED=true

# Server selection timeout in milliseconds
MONGODB_TIMEOUT_MS=2000

# CORS Allowed Origins (Comma-separated)
NUTRISENSE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication & Security (JWT)
# Secure random secret key for signing JWT tokens (min 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long

# Cryptographic signing algorithm
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=60
REGISTER_RATE_LIMIT=60

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------

# Backend API Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000
